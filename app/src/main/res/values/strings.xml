    <string name="unit_name_bottle">bottle</string>
    <string name="unit_name_slice">slice</string>
    <string name="unit_name_cup">cup</string>

    <!-- The problem of a field, below the field. -->
    <string name="error_name_empty">Enter a name.</string>
    <string name="error_name_too_long">The name is too long. Use 80 characters or fewer.</string>
    <string name="error_name_in_use">Another food has this name.</string>
    <string name="error_quantity_empty">Enter a quantity.</string>
    <string name="error_quantity_not_a_number">Enter a number, for example 1.5.</string>
    <string name="error_quantity_decimals">Use 3 decimal places or fewer.</string>

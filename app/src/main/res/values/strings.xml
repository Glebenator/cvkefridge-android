    <!-- A write to the change log failed. -->
    <string name="save_failed">Couldn\'t save the change. The inventory file can\'t be written.</string>
    <string name="save_failed_form">Couldn\'t save. The inventory file can\'t be written. Your entries are still here. Try again.</string>

    <!-- The inventory changed, and an action is not possible now. -->
    <string name="refused_unknown_product">This food is no longer in the inventory.</string>
    <string name="refused_unknown_batch">This batch is no longer in the inventory.</string>
    <string name="refused_unknown_storage_area">This storage area is no longer there. Select a different one.</string>
    <string name="refused_fixed_storage_area">Fridge and Freezer are fixed. You can\'t change or delete them.</string>
    <string name="refused_storage_area_in_use">This storage area has food in it. Move the food, or record it as used or thrown away, and then delete the storage area.</string>
    <string name="refused_batch_ended">This batch has no quantity left.</string>
    <string name="refused_duplicate_batch">Couldn\'t add the batch. Try again.</string>
    <string name="refused_cannot_undo">This can\'t be undone.</string>

    <!-- The snackbar after an action. %1$s is the name of a food or of a storage area. -->
    <string name="notice_added">%1$s added</string>
    <string name="notice_deleted">%1$s deleted</string>
    <!-- %1$s is a quantity with its unit, %2$s the name of the food: "1.5 l of Whole milk used". -->
    <string name="notice_used">%1$s of %2$s used</string>
    <string name="notice_thrown_away">%1$s of %2$s thrown away</string>

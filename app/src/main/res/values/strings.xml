        <item quantity="one">%1$s pack</item>
        <item quantity="other">%1$s packs</item>
    </plurals>
    <plurals name="unit_bottle">
        <item quantity="one">%1$s bottle</item>
        <item quantity="other">%1$s bottles</item>
    </plurals>
    <plurals name="unit_slice">
        <item quantity="one">%1$s slice</item>
        <item quantity="other">%1$s slices</item>
    </plurals>
    <plurals name="unit_cup">
        <item quantity="one">%1$s cup</item>
        <item quantity="other">%1$s cups</item>
    </plurals>

    <!-- The change log could not be read. FridgeFriend has no text for this. -->
    <string name="load_failed">Couldn\'t load items. The inventory file can\'t be read.</string>
    <string name="action_try_again">Try again</string>

    <!-- Actions that more than one screen has. -->
    <string name="action_back">Back</string>
    <string name="action_close">Close</string>
    <string name="action_ok">OK</string>
    <string name="action_cancel">Cancel</string>
    <string name="action_save">Save</string>
    <string name="action_undo">Undo</string>

    <!-- The form that adds food. Also the name of the button that opens it. -->
    <string name="add_food">Add food</string>
    <string name="action_save_and_add_another">Save and add another</string>
    <string name="field_name">Name</string>
    <string name="field_category">Category</string>
    <string name="field_quantity">Quantity</string>
    <string name="field_unit">Unit</string>
    <string name="field_expiry_date">Expiry date</string>
    <!-- Below the name field, when a product in the inventory has this name. -->
    <string name="add_food_existing">This food is in your inventory. The form adds a batch to it.</string>
    <!-- Below a suggested name that is the name of a product in the inventory. -->
    <string name="suggestion_in_inventory">In your inventory</string>
    <!-- The last item in the list of the storage areas of a form. -->
    <string name="storage_areas_manage">Manage storage areas</string>
    <string name="error_storage_area">Select a storage area.</string>

    <!-- The screen of one food. -->
    <!-- The title while the food loads. -->
    <string name="food_title">Food</string>
    <plurals name="food_batches">
        <item quantity="one">%1$d batch</item>
        <item quantity="other">%1$d batches</item>
    </plurals>
    <!-- On the batch that a use takes from first. -->
    <string name="food_use_first">Use first</string>
    <string name="food_no_batches">No batches of this food</string>
    <string name="food_add_batch">Add a batch</string>
    <!-- %1$s is a date. -->
    <string name="batch_printed_date">Printed date: %1$s</string>
    <string name="batch_estimated_date">Estimated date: %1$s</string>
    <string name="batch_date_added">Added %1$s</string>

    <!-- Used and thrown away. -->
    <string name="action_used">Used</string>
    <string name="action_thrown_away">Thrown away</string>
    <!-- The menu items that open the dialog for a quantity. -->
    <string name="action_used_quantity">Used…</string>
    <string name="action_thrown_away_quantity">Thrown away…</string>
    <string name="take_used_title">How much was used?</string>
    <string name="take_thrown_away_title">How much was thrown away?</string>
    <!-- %1$s is the name of the food, %2$s a quantity with its unit. -->
    <string name="take_available">%1$s: you have %2$s. The quantity comes from the oldest batch first.</string>
    <!-- %1$s is a quantity with its unit. -->
    <string name="error_take_too_much">You have only %1$s.</string>

    <!-- Delete is for a mistake. -->
    <string name="action_delete">Delete</string>
    <string name="food_delete">Delete food</string>
    <string name="batch_delete">Delete batch</string>
    <!-- For screen readers: the buttons that open a menu. %1$s is the name of the food. -->
    <string name="food_more_actions">More actions for %1$s</string>
    <string name="batch_more_actions">More actions for this batch</string>
    <string name="more_actions">More actions</string>

    <!-- The forms that edit a product and a batch. -->
    <string name="edit_food">Edit food</string>
    <string name="edit_batch">Edit batch</string>
    <string name="edit_food_unit_note">The unit is the unit of all batches of this food.</string>
    <string name="field_date_added">Date added</string>

    <!-- The expiry date of a form. -->
    <string name="no_expiry_date">No expiry date</string>
    <string name="expiry_use_estimate">Use the estimated date</string>
    <!-- Below an estimated date. %1$s says where the estimate comes from. -->
    <string name="expiry_help_estimated">%1$s Select the field to enter the printed date.</string>

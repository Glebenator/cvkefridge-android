    <string name="expiry_help_printed">Printed date, from the package.</string>
    <string name="expiry_help_none">This batch has no expiry date. Select the field to enter the printed date.</string>
    <string name="expiry_help_no_estimate">The app has no estimate for this food here. Select the field to enter the printed date.</string>

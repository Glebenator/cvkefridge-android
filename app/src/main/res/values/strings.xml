<resources>
    <string name="app_name">CVKE Fridge</string>

    <!-- The text of the two screens starts from the text of FridgeFriend (the basic_ff repository). -->

    <!-- Tabs -->
    <string name="tab_home">Home</string>
    <string name="tab_my_fridge">My Fridge</string>

    <!-- Home -->
    <string name="greeting_morning">Good morning</string>
    <string name="greeting_afternoon">Good afternoon</string>
    <string name="greeting_evening">Good evening</string>
    <string name="home_title">Your Kitchen</string>
    <string name="hero_label">Total items</string>
    <!-- Shows in the place of a number that is not loaded. -->
    <string name="hero_no_value">—</string>
    <string name="metric_expiring">Expiring</string>
    <string name="metric_expired">Expired</string>
    <!-- For screen readers: what a tap on "Expiring" or "Expired" does. -->
    <string name="metric_show">Show in My Fridge</string>
    <string name="attention_title">Needs attention</string>
    <string name="attention_view_all">View all</string>
    <string name="attention_none_title">All fresh</string>
    <!-- %1$d is the number of days in which a batch is "expiring". -->
    <plurals name="attention_none_body">
        <item quantity="one">Nothing has expired, and nothing expires in the next day.</item>
        <item quantity="other">Nothing has expired, and nothing expires in the next %1$d days.</item>
    </plurals>

    <!-- About -->
    <string name="about">About</string>
    <!-- %1$s is the version with the build number, for example "0.1.0 (1)". -->
    <string name="about_version">Version %1$s</string>
    <!-- The logo of the maker comes after these words. -->
    <string name="about_made_by">Made by</string>
    <!-- For screen readers: the name in the logo of the maker. -->
    <string name="about_maker" translatable="false">cvke</string>

    <!-- The two screens -->
    <string name="loading">Loading…</string>
    <string name="no_items">No items yet</string>

    <!-- The days left of a batch or a food. "d" is the short form of "days". -->
    <string name="expired_days_ago">Expired %1$dd ago</string>
    <string name="expired_yesterday">Expired yesterday</string>
    <string name="expires_today">Expires today</string>
    <string name="expires_tomorrow">Expires tomorrow</string>
    <string name="expires_in_days">Expires in %1$dd</string>
    <string name="no_expiry">No expiry</string>
    <!-- The days left when the app suggested the expiry date. %1$s is the text, for example "Expires in 3d". -->
    <string name="expiry_estimated">%1$s, estimated</string>

    <!-- My Fridge -->
    <string name="search_placeholder">Search items</string>
    <string name="search_clear">Clear search</string>
    <!-- The tab of all storage areas. The other tabs have the names of the storage areas. -->
    <string name="area_all">All</string>
    <!-- The chip that opens the list of categories, when no category is selected. Also for screen readers: the group. -->
    <string name="filter_category">Category</string>
    <string name="category_all">All categories</string>
    <string name="filter_expiring">Expiring</string>
    <string name="filter_expired">Expired</string>
    <!-- For screen readers: the groups of the tabs and of the two freshness chips. -->
    <string name="filter_storage_area">Storage area</string>
    <string name="filter_freshness">Freshness</string>
    <!-- For screen readers: one tab or chip. %1$s is the group, %2$s the value, for example "Storage area: Freezer". -->
    <string name="filter_description">%1$s: %2$s</string>
    <!-- For screen readers: a filter with its number of foods. %1$s is the filter, for example "Dairy, 3 items". -->
    <plurals name="filter_count_description">
        <item quantity="one">%1$s, %2$d item</item>
        <item quantity="other">%1$s, %2$d items</item>
    </plurals>
    <!-- There is food, but none for the filters and the search text. -->
    <string name="list_no_match">No matching items</string>
    <string name="filter_clear">Clear filters</string>
    <plurals name="expiry_date_count">
        <item quantity="one">%1$d expiry date</item>
        <item quantity="other">%1$d expiry dates</item>
    </plurals>

    <!-- The sort control -->
    <string name="sort_name">Name</string>
    <string name="sort_expiry">Expiry</string>
    <string name="sort_date_added">Date added</string>
    <string name="sort_quantity">Quantity</string>
    <string name="sort_category">Category</string>
    <!-- For screen readers. %1$s is the sort order, for example "Expiry". -->
    <string name="sort_change_key">Sort by %1$s</string>
    <string name="sort_ascending">Ascending order</string>
    <string name="sort_descending">Descending order</string>

    <!-- Categories -->
    <string name="category_produce">Produce</string>
    <string name="category_dairy">Dairy</string>
    <string name="category_meat">Meat</string>
    <string name="category_condiment">Condiment</string>
    <string name="category_beverage">Beverage</string>
    <string name="category_bakery">Bakery</string>
    <string name="category_leftovers">Leftovers</string>
    <string name="category_other">Other</string>

    <!-- The sign between two short values on one line, for example "2 l • Expires in 3d". -->
    <string name="meta_separator">•</string>

    <!-- A quantity with its unit. %1$s is the number in the format of the locale. -->
    <string name="unit_pcs">%1$s pcs</string>
    <string name="unit_g">%1$s g</string>
    <string name="unit_kg">%1$s kg</string>
    <string name="unit_ml">%1$s ml</string>
    <string name="unit_l">%1$s l</string>
    <plurals name="unit_pack">
        <item quantity="one">%1$s pack</item>
        <item quantity="other">%1$s packs</item>
    </plurals>
    <plurals name="unit_bottle">
        <item quantity="one">%1$s bottle</item>
        <item quantity="other">%1$s bottles</item>
    </plurals>
    <plurals name="unit_slice">
        <item quantity="one">%1$s slice</item>
        <item quantity="other">%1$s slices</item>
    </plurals>
    <plurals name="unit_cup">
        <item quantity="one">%1$s cup</item>
        <item quantity="other">%1$s cups</item>
    </plurals>

    <!-- The change log could not be read. FridgeFriend has no text for this. -->
    <string name="load_failed">Couldn\'t load items. The inventory file can\'t be read.</string>
    <string name="action_try_again">Try again</string>

    <!-- The sample of the debug build. -->
    <string name="sample_note">Sample data</string>
</resources>

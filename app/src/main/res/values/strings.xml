    <string name="reminders_time_title">Time of the reminder</string>
    <string name="time_input_keyboard">Type the time</string>
    <string name="time_input_clock">Select the time on a clock</string>

    <!-- The offer of reminders on Home. %1$s is a time, for example "9:00 AM". -->
    <string name="reminders_offer_title">Get a reminder before food expires</string>
    <string name="reminders_offer_body">One notification a day at %1$s names the food that expires soon. You can change the time in Settings.</string>
    <string name="action_turn_on">Turn on</string>
    <string name="action_not_now">Not now</string>
    <string name="action_continue">Continue</string>
    <string name="reminders_on">Reminders are on</string>
    <string name="reminders_in_settings">You can turn on reminders in Settings at any time.</string>
    <string name="settings_not_saved">Couldn\'t save the setting. Try again.</string>

    <!-- The explanation before Android asks for the notification permission. -->
    <string name="notifications_ask_title">Allow notifications</string>
    <string name="notifications_ask_body">Reminders are notifications. Next, Android asks if CVKE Fridge can send notifications. The app sends not more than one a day, and only when food needs attention. The app makes the reminder on your phone. No data leaves your phone.</string>
    <!-- Notifications are off and only the settings of Android can turn them on. -->
    <string name="notifications_off_title">Notifications are off</string>
    <string name="notifications_blocked_body">Notifications for CVKE Fridge are off. To get reminders, open the settings and turn them on.</string>
    <string name="notifications_channel_off_body">The notification category Expiry reminders is off. To get reminders, open the settings and turn it on.</string>
    <!-- On the settings screen, when reminders are on and Android does not show them. -->
    <string name="notifications_denied_status">Notifications for CVKE Fridge are not allowed, so reminders cannot show.</string>
    <string name="notifications_blocked_status">Notifications for CVKE Fridge are off in the settings of Android, so reminders cannot show.</string>
    <string name="notifications_channel_off_status">The notification category Expiry reminders is off in the settings of Android, so reminders cannot show.</string>
    <string name="action_allow_notifications">Allow notifications</string>

    <!-- The reminder notification. -->
    <string name="reminder_channel_name">Expiry reminders</string>
    <string name="reminder_channel_description">One notification a day that names the food that expires soon or expired yesterday.</string>
    <!-- %1$d is the number of foods in the reminder. -->
    <plurals name="reminder_title">
        <item quantity="one">%1$d item needs attention</item>
        <item quantity="other">%1$d items need attention</item>
    </plurals>
    <!-- Between two names of food. The quotes keep the space. -->
    <string name="reminder_name_separator">", "</string>
    <!-- %1$s is a list of names, %2$d the number of foods that are not in the list. -->
    <plurals name="reminder_names_more">
        <item quantity="one">%1$s and %2$d more</item>
        <item quantity="other">%1$s and %2$d more</item>
    </plurals>
    <!-- The last line of the expanded reminder. %1$d is the number of foods that do not have a line. -->
    <plurals name="reminder_lines_more">
        <item quantity="one">And %1$d more</item>
        <item quantity="other">And %1$d more</item>
    </plurals>
    <!-- One line for each food. %1$s is the days left, for example "Expires today, estimated", %2$s the name of the food. -->
    <string name="reminder_line">%1$s: %2$s</string>
    <!-- The days left in a line of the reminder, in words. %1$d is the number of days. -->
    <plurals name="reminder_expires_in_days">
        <item quantity="one">Expires in %1$d day</item>
        <item quantity="other">Expires in %1$d days</item>
    </plurals>


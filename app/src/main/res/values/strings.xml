    <string name="reminders_next_tomorrow">Next reminder: tomorrow at about %1$s.</string>
    <!-- %1$s is a date, %2$s a time. -->
    <string name="reminders_next_date">Next reminder: %1$s at about %2$s.</string>
    <string name="reminders_next_note">The reminder comes only when food needs attention. The time is approximate: Android can send it later to save battery.</string>

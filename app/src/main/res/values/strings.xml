    <plurals name="expiry_estimate_hint">
        <item quantity="one">Estimate for %1$s (%2$s): %3$d day.</item>
        <item quantity="other">Estimate for %1$s (%2$s): %3$d days.</item>
    </plurals>

    <!-- Storage kinds -->
    <string name="storage_kind_pantry">Pantry</string>
